{
  "env": {
    "browser": true,
    "commonjs": true,
    "es2021": true,
    "node": true,
    "jest": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-undef": "warn",
    "no-regex-spaces": "off",
    "no-empty": "off"
  },
  "globals": {
    "showStatus": "readonly",
    "formatDate": "readonly",
    "generateId": "readonly"
  }
}